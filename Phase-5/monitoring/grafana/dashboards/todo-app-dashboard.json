{
  "dashboard": {
    "id": null,
    "title": "Todo App Dashboard",
    "tags": ["todo-app", "dapr", "kafka", "kubernetes"],
    "style": "dark",
    "timezone": "browser",
    "refresh": "5s",
    "schemaVersion": 27,
    "version": 22,
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    },
    "templating": {
      "list": [
        {
          "allValue": null,
          "current": {
            "selected": false,
            "text": "All",
            "value": "$__all"
          },
          "datasource": "Prometheus",
          "definition": "label_values(kubernetes_pod_name)",
          "description": "Kubernetes Pod",
          "error": null,
          "hide": 0,
          "includeAll": true,
          "label": "Pod",
          "multi": true,
          "name": "pod",
          "options": [],
          "query": {
            "query": "label_values(kubernetes_pod_name)",
            "refId": "StandardVariableQuery"
          },
          "refresh": 1,
          "regex": "",
          "skipUrlSync": false,
          "sort": 0,
          "tagValuesQuery": "",
          "tags": [],
          "tagsQuery": "",
          "type": "query",
          "useTags": false
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Application Health",
        "type": "stat",
        "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(up{job=\"todo-app\"})",
            "legendFormat": "Running Instances",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "green", "value": 2}
              ]
            },
            "unit": "none"
          }
        },
        "valueMappings": [],
        "pluginVersion": "8.0.0"
      },
      {
        "id": 2,
        "title": "HTTP Requests Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
        "targets": [
          {
            "expr": "sum(rate(http_requests_total[5m])) by (status)",
            "legendFormat": "Status {{status}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Requests/sec",
            "show": true
          }
        ]
      },
      {
        "id": 3,
        "title": "Response Time",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(dapr_app_http_request_duration_seconds_bucket[5m])) by (le, kubernetes_pod_name))",
            "legendFormat": "{{kubernetes_pod_name}} - 95th percentile",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Seconds",
            "show": true
          }
        ]
      },
      {
        "id": 4,
        "title": "Dapr Sidecar Status",
        "type": "stat",
        "gridPos": {"h": 5, "w": 6, "x": 0, "y": 13},
        "targets": [
          {
            "expr": "count(up{job=\"dapr\"})",
            "legendFormat": "Active Sidecars",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "green", "value": 2}
              ]
            },
            "unit": "none"
          }
        }
      },
      {
        "id": 5,
        "title": "Kafka Event Processing",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
        "targets": [
          {
            "expr": "sum(rate(dapr_pubsub_message_received_total[5m])) by (pubsub_name)",
            "legendFormat": "{{pubsub_name}} - Messages Received",
            "refId": "A"
          },
          {
            "expr": "sum(rate(dapr_pubsub_message_published_total[5m])) by (pubsub_name)",
            "legendFormat": "{{pubsub_name}} - Messages Published",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "label": "Messages/sec",
            "show": true
          }
        ]
      },
      {
        "id": 6,
        "title": "Task Operations",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18},
        "targets": [
          {
            "expr": "sum(rate(todo_task_operations_total[5m])) by (operation)",
            "legendFormat": "{{operation}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Operations/sec",
            "show": true
          }
        ]
      },
      {
        "id": 7,
        "title": "Memory Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26},
        "targets": [
          {
            "expr": "container_memory_usage_bytes{container=\"todo-backend\"}",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Bytes",
            "show": true
          }
        ]
      },
      {
        "id": 8,
        "title": "CPU Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26},
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{container=\"todo-backend\"}[5m])",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Cores",
            "show": true
          }
        ]
      }
    ],
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": "-- Grafana --",
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "description": "Dashboard for monitoring the Todo App with Dapr integration",
    "links": [],
    "liveNow": false,
    "panels": [],
    "refresh": "5s",
    "schemaVersion": 30,
    "style": "dark",
    "tags": ["todo-app", "dapr", "kafka", "kubernetes"],
    "templating": {
      "list": []
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {},
    "timezone": "",
    "title": "Todo App Dashboard",
    "uid": "todo-app-dashboard",
    "version": 1,
    "weekStart": ""
  }
}